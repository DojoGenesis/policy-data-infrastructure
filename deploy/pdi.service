[Unit]
Description=Policy Data Infrastructure API
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dojo
Group=dojo
# modelsDir/evidenceDir (pkg/gateway/briefs.go) are relative paths resolved
# from the process cwd, not the binary's location. Default systemd cwd is
# "/", which has no data/policies/ tree. This must be the directory that
# contains data/policies/models/ and data/policies/evidence/ on this box.
WorkingDirectory=/opt/pdi
ExecStart=/usr/local/bin/pdi serve --port 8340
EnvironmentFile=/etc/pdi/env
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target
