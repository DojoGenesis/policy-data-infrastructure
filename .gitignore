# Cloudflare Wrangler working directory
.wrangler/

# Binaries
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go build artifacts
*.test
*.out

# Go module cache
vendor/

# Test coverage output
coverage.html
coverage.out

# Database files
data/*.db
data/*.sqlite
data/*.sqlite3

# Large geospatial files — do not commit; fetch via ingest scripts
*.geojson
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gdb/
*.gpkg
*.pbf
*.osm
*.zip

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Python ingest
__pycache__/
*.py[cod]
*.pyo
.venv/
ingest/.venv/
ingest/venv/
ingest/*.egg-info/
dist/
build/

# Generated analysis outputs — regenerable, do not commit
analysis/output/

# Temporary / scratch files
tmp/
scratch/
*.tmp
*.bak
# The built binary at the repo root. Anchored: a bare "pdi" also matches the
# cmd/pdi DIRECTORY, which silently blocks every new file added there — a new
# CLI subcommand can be committed as a call site with its definition left
# untracked, and the repo then fails to build from a clean clone.
/pdi
/pdi-linux
.envrc

# Manim intermediate render cache — hash-named, fully regenerated on every render.
# The final scene MP4s (media/videos/<scene>/<quality>/<Scene>.mp4) stay tracked.
media/videos/**/partial_movie_files/

# Ad-hoc dev tooling: scripts/layout-check.mjs needs playwright, installed
# with `npm install --no-save playwright` rather than a tracked manifest.
node_modules/
